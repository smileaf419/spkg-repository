####
## x265 build
## Copyright 2023-2026 spkg developers, licensed under GPLv2
HOMEPAGE="http://x265.org/ https://github.com/Multicorewareinc/x265"
DESCRIPTION="Library for encoding video streams into the H.265/HEVC format"
LICENSE="GPLv2"
SRC_URI=("https://github.com/Multicorewareinc/x265/releases/download/$PKG_VER/x265_$PKG_VER.tar.gz")
#PATCHES=()
DEPS=""
BDEPS=""
RDEPS=""
ARCHS="~x86 ~x86_64"
SLOT=0
setBuildENV cmake
BUILD_SEPERATE_DIR=no
B=x265-$PKG_VER/source

src_configure() {
	configure_default ~-DGIT_ARCHSETYPE=1 ~\
					  -W no-dev
}

src_test() { :; }

src_install() {
	install_default

	rm -v "${D}"/usr/lib/libx265.a
}
